# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Main model. If it is overloaded (503) or out of quota (429) the app switches
# to GEMINI_FALLBACK_MODEL automatically.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# 1 = always let the sidebar save the key to this file, 0 = never.
# Default: only when the app is opened on this computer (localhost).
# DARA_SAVE_KEY=1
